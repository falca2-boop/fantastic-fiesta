# Pflicht: Anthropic API Key (bleibt auf dem Server, nie im Browser)
ANTHROPIC_API_KEY=sk-ant-...

# Zugangs-Token für die Weboberfläche. Pflicht, sobald der Server nicht nur lokal läuft.
# Beliebig lang und zufällig, z. B.: openssl rand -hex 24
JARVIS_TOKEN=

# Optional
JARVIS_USER_NAME=Augustin
JARVIS_MODEL=claude-haiku-5-5   # schnell (Standard); für mehr Gründlichkeit claude-sonnet-5-5
PORT=8000
HOST=127.0.0.1          # im Container/auf Hosting: 0.0.0.0
DATA_DIR=./data         # hier liegen Aufgaben, Notizen, Erinnerungen
# n8n-Webhook für externe Aktionen (E-Mail, Kalender, Notion …)
N8N_WEBHOOK_URL=

# --- Meldung bei wichtigen neuen E-Mails: IMAP_* plus mindestens ein Meldeweg (NTFY_TOPIC und/oder Anruf) ---
IMAP_HOST=imap.gmx.net          # web.de: imap.web.de
IMAP_PORT=993
IMAP_USER=deine@adresse.de
IMAP_PASSWORD=                  # Passwort des Postfachs (IMAP muss im Postfach freigeschaltet sein)
NTFY_TOPIC=                     # langer, zufälliger Name, z. B. jarvis-mail-8f3k29x0qpa7 (geheim halten!)
# NTFY_SERVER=https://ntfy.sh
MAIL_POLL_SECONDS=60
MAIL_IMPORTANT_SENDERS=         # Komma-getrennt, z. B. finanzamt,chef@firma.de
MAIL_IMPORTANT_KEYWORDS=        # Komma-getrennt, im Betreff, z. B. dringend,rechnung
MAIL_ALERT_INCLUDE_SUBJECT=true # false: Push enthält keinen Betreff

# Anruf per Twilio (optional): JARVIS ruft an und liest vor, von wem die Mail ist
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                    # deine Twilio-Nummer, z. B. +4930123456
CALL_TO=                        # deine Handynummer, z. B. +491701234567
MAIL_CALL_MIN_INTERVAL_SECONDS=300   # höchstens ein Anruf pro Zeitfenster

# --- Stimme von JARVIS über ElevenLabs (beide Variablen nötig, sonst Browser-Stimme) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=            # ID der Stimme, z. B. aus elevenlabs.io/app/voice-library → "ID kopieren"
# ELEVENLABS_MODEL=eleven_flash_v2_5   # schnell (Standard); für schönere Aussprache eleven_multilingual_v2

# --- Dauerhaftes Gedächtnis auch bei flüchtigem Dateisystem (z. B. Render Free) ---
# Kostenlose Redis-Datenbank bei upstash.com anlegen, Werte unter "REST API" kopieren. Beide Variablen nötig.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
