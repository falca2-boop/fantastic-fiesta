# Pflicht: Anthropic API Key (bleibt auf dem Server, nie im Browser)
ANTHROPIC_API_KEY=sk-ant-...

# Zugangs-Token für die Weboberfläche. Pflicht, sobald der Server nicht nur lokal läuft.
# Beliebig lang und zufällig, z. B.: openssl rand -hex 24
JARVIS_TOKEN=

# Optional
JARVIS_USER_NAME=Augustin
JARVIS_MODEL=claude-sonnet-5-5
PORT=8000
HOST=127.0.0.1          # im Container/auf Hosting: 0.0.0.0
DATA_DIR=./data         # hier liegen Aufgaben, Notizen, Erinnerungen
# n8n-Webhook für externe Aktionen (E-Mail, Kalender, Notion …)
N8N_WEBHOOK_URL=

# --- Push aufs Handy bei wichtigen neuen E-Mails (alles vier Variablen nötig, sonst aus) ---
IMAP_HOST=imap.gmx.net          # web.de: imap.web.de
IMAP_PORT=993
IMAP_USER=deine@adresse.de
IMAP_PASSWORD=                  # Passwort des Postfachs (IMAP muss im Postfach freigeschaltet sein)
NTFY_TOPIC=                     # langer, zufälliger Name, z. B. jarvis-mail-8f3k29x0qpa7 (geheim halten!)
# NTFY_SERVER=https://ntfy.sh
MAIL_POLL_SECONDS=60
MAIL_IMPORTANT_SENDERS=         # Komma-getrennt, z. B. finanzamt,chef@firma.de
MAIL_IMPORTANT_KEYWORDS=        # Komma-getrennt, im Betreff, z. B. dringend,rechnung
MAIL_ALERT_INCLUDE_SUBJECT=true # false: Push enthält keinen Betreff
