# ── Pflicht ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Zugangs-Token (Pflicht wenn HOST nicht localhost) ─────────────────────────
# openssl rand -hex 24
JARVIS_TOKEN=

# ── Optional ──────────────────────────────────────────────────────────────────
JARVIS_USER_NAME=Augustin
JARVIS_MODEL=claude-sonnet-4-5
PORT=8000
HOST=127.0.0.1          # Für Hosting/Docker: 0.0.0.0
DATA_DIR=./data

# ── Stimme: ElevenLabs (optional, Fallback: Browser-TTS) ─────────────────────
# API-Key unter elevenlabs.io → Developers → API Keys
# Voice-ID: elevenlabs.io/app/voice-library → Stimme wählen → "ID kopieren"
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
